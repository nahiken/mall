# 环境变量模板（#108：复制为 .env 并填入真实值；.env 已被 git 忽略不入库）
# 各键与 mall_agent/config.py 的 os.getenv 一一对应。敏感值（API key / DB 密码）只经 .env
# / 容器环境变量注入，绝不入 git。

# Deepseek 在线模型 API 的配置（真实 key 只放 .env / 容器 env）
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Java Mall 后端地址（mall_agent/config.py 读取；容器内指 portal 服务名）
MALL_API_BASE=http://localhost:8085

# 服务监听
HOST=0.0.0.0
PORT=8002

# Mall Agent 会话历史库（MySQL）
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=change-me
DB_NAME=kefu_agent

# 后台并发 worker 数
WORKER_COUNT=4

# RAG 知识库 HTTP 服务（RAG-MCP-SERVER 的 REST 层，对话增强用）
RAG_HTTP_URL=http://127.0.0.1:8123

# ── 可选（#104/#105/#106 新增，缺省走代码默认）──────────────────────────
# 队列后端：memory | redis（Redis Streams 总线，多实例）
# QUEUE_BACKEND=memory
# Redis 连接（QUEUE_BACKEND=redis 时）
# REDIS_URL=redis://127.0.0.1:6379/0
# DB 连接池（随 WORKER_COUNT 放大）
# DB_POOL_SIZE=5
# DB_POOL_MAX_OVERFLOW=10
# portal 会员 JWT 验签（#106：配成 mall-portal application.yml 的 jwt.secret；空=关）
# PORTAL_JWT_SECRET=
# PORTAL_JWT_ALGORITHM=HS256
# PORTAL_ADMIN_USERS=admin
# 会话上下文：服务端权威（on）/ 客户端自报（off）
# MALL_AGENT_CTX_SERVER=on
# 决策流 node trace
# MALL_AGENT_NODE_TRACE=on

# ── 管理面鉴权（P0-01，默认 fail-closed：未配凭据时 /api/monitor/* 与 /queue/status 一律 401）
# 运维脚本通道：请求头 X-Monitor-Token 与本值完全一致才放行（空=不启用该通道）
# MONITOR_TOKEN=change-me-to-a-long-random-string
# admin 前端通道：配成 mall-admin application.yml 的 jwt.secret，监控页复用登录 token
# ADMIN_JWT_SECRET=
# 本地排障回滚：off 会恢复管理面匿名访问，切勿在生产使用
# MONITOR_AUTH=on

# ── 浏览器跨域白名单（P0-02，逗号分隔的完整 Origin；不支持 *）
# 默认 http://localhost:5173,http://localhost:5174（admin/app dev）
# 生产同源部署时设为空串：CORS_ORIGINS=
# CORS_ORIGINS=http://localhost:5173,http://localhost:5174
