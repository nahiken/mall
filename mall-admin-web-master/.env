# 后端API基础路径
# #108 相对化：prod 构建同源经 gateway/nginx 剥前缀（dev 直连绝对地址见 .env.development）
VITE_BASE_SERVER_URL = /admin-api
# 是否使用OSS对象存储
VITE_USE_OSS = false
# OSS上传路径
VITE_OSS_UPLOAD_URL = http://macro-oss.oss-cn-shenzhen.aliyuncs.com
# Minio上传相对路径
VITE_MINIO_UPLOAD_URL = /minio/upload
# Agent 服务地址（同源，gateway 剥 /agent-api → mall-agent）
VITE_AGENT_BASE_URL = /agent-api
# RAG 知识库服务地址（同源，gateway 剥 /rag-api → RAG HTTP :8123）
VITE_RAG_BASE_URL = /rag-api
