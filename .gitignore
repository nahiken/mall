.venv/
venv/
env/
ENV/
*.venv
venv.bak/

__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.ruff_cache/
.mypy_cache/
htmlcov/
.coverage*

# ────────────────────────────────────────────────────────────────────────────
# 六、Java / Maven
# ────────────────────────────────────────────────────────────────────────────
target/
*.class
*.jar
*.war
*.ear
*.logs
.apt_generated
.aps_generated
.apt_generated_tests
.springBeans
.sts-cache
.sts-cache/
.springBeansStsCache
.mvn/
maven-wrapper/
!maven-wrapper.jar

# ────────────────────────────────────────────────────────────────────────────
# 七、前端 node / 构建产物
# ────────────────────────────────────────────────────────────────────────────
node_modules/
dist/
dist_verify/
dist-verify/
unpackage/
.coverage
.vercel
.vite/
*.tsbuildinfo

# ────────────────────────────────────────────────────────────────────────────
# 八、IDE / 操作系统
# ────────────────────────────────────────────────────────────────────────────
.idea/
*.iml
*.iws
*.ipr
out/
.vscode/
Thumbs.db
.DS_Store
desktop.ini

# ────────────────────────────────────────────────────────────────────────────
# 九、其他临时文件
# ────────────────────────────────────────────────────────────────────────────
*.tmp
*.bak
*.swp
*.swo
