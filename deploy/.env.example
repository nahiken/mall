# P0-03/P0-04：docker compose 环境变量模板（复制为 deploy/.env，勿入库）。
# 账号要求：admin/portal 用同一个读写账号（示例 mall_rw），需 DBA 在 mall 库授予
# SELECT/INSERT/UPDATE/DELETE；reader 只留给 mall-search 这类纯读服务。
# 轮换提醒：本文件所有 change-me 值都必须在部署前替换为真实随机值。
DB_USER=mall_rw
DB_PASSWORD=change-me
JWT_SECRET=change-me-to-a-long-random-string
# 浏览器跨域白名单：同源 nginx 部署留空；分域部署填完整 Origin，逗号分隔
CORS_ALLOWED_ORIGINS=
# mall-agent 管理面鉴权（P0-01）：运维脚本 token + admin JWT 验签密钥
MONITOR_TOKEN=
ADMIN_JWT_SECRET=
PORTAL_JWT_SECRET=
# mall-search 写接口内部 token（P0-05）：留空=写接口关闭；网关已拒绝公网写入口
SEARCH_INTERNAL_TOKEN=
QUEUE_BACKEND=redis
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
# P1-02：Agent 商品检索走 ES；ES 不可用时自动回退 portal。超时单位秒。
SEARCH_TIMEOUT_SECONDS=2
# P1-01：LLM 超时/重试（秒/次）；合并意图默认开启
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=1
