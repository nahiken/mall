# 开发环境配置

# 应用标题
VITE_APP_TITLE=Mall商城（开发环境）

# API 基础地址（开发环境使用本地或测试服务器）
VITE_API_BASE_URL=http://localhost:8085

# Elasticsearch 搜索服务地址
VITE_SEARCH_API_BASE_URL=http://localhost:8081

# AI Agent 服务地址
VITE_AGENT_BASE_URL=http://localhost:8002

# 是否开启调试模式
VITE_APP_DEBUG=true

# 是否使用支付宝支付（H5端启用）
VITE_USE_ALIPAY=true
