# 通用环境变量配置

# 应用标题
VITE_APP_TITLE=Mall商城

# API 基础地址（默认使用开发环境）
# #108 相对化：prod 构建同源经 gateway/nginx 剥前缀（dev 直连绝对地址见 .env.development）
VITE_API_BASE_URL=/mall-api

# Elasticsearch 搜索服务地址
VITE_SEARCH_API_BASE_URL=/search-api

# AI Agent 服务地址
VITE_AGENT_BASE_URL=/agent-api

# 是否开启调试模式
VITE_APP_DEBUG=false

# 是否使用支付宝支付（H5端启用）
VITE_USE_ALIPAY=false
